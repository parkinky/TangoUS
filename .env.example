# mywebsite — 환경변수 템플릿
# 실제 값을 채운 뒤 파일명을 .env.local로 저장하세요 (git에는 커밋되지 않습니다).

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic API (번역 + 자동 수집용 web search) ---
ANTHROPIC_API_KEY=

# --- Twilio Verify (SMS OTP) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Vercel Cron 보호용 (자동 수집 API 라우트 인증) ---
CRON_SECRET=

# --- 배포 사이트 URL ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google Maps (선택) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
